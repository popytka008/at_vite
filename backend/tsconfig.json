{
  "compilerOptions": {
    "outDir": "./dist",
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": true,
    "skipLibCheck": true,
    "strict": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "inlineSources": true,
    "isolatedModules": false,
    "lib": [
      "ES2021"
    ],
    "module": "Node16",
    "target": "ES2021",
    "rootDir": "./src",
    "types": [
      "node"
    ],
    "declaration": true,
    "moduleResolution": "NodeNext"
  },
  "include": [
    "src"
  ]
}
