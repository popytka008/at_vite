{
  "name": "@at_vite/backend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash": "^4.17.27",
    "@types/node": "^26.6.6",
    "@types/passport": "^1.0.17",
    "@types/passport-jwt": "^4.0.1",
    "cross-env": "^10.1.0",
    "prisma": "^5.22.0",
    "trpc-ui-zod4": "^1.1.0"
  },
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx --watch --trace-warnings src/index.ts",
    "build": "rimraf ./dist && tsc -b ./tsconfig.json",
    "start": "node ./dist/index.js",
    "types": "tsc --noEmit --project ./tsconfig.json",
    "pmd": "prisma migrate dev",
    "pgs": "prisma generate",
    "prepare": "pnpm pgs"
  },
  "prisma": {
    "schema": "./src/prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@trpc/server": "^11.22.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "lodash": "^4.18.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "superjson": "^2.2.6",
    "zod": "^4.6.7"
  }
}
